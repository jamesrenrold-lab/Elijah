{
  "type": "origins:active_self",
  "name": "Blood Rush",
  "description": "Quinary ability: on a 15-second cooldown, gain 20 blood charge and a 10-second buff granting 10% movement speed, attack speed and lifesteal. Filling the meter to 100 consumes it and triggers 20 seconds of blindness, darkness, strength and health degeneration.",
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:resource",
      "resource": "elijah:blood_resource",
      "comparison": ">=",
      "compare_to": 80
    },
    "if_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:change_resource",
          "resource": "elijah:blood_resource",
          "change": 20
        },
        {
          "type": "origins:change_resource",
          "resource": "elijah:blood_resource",
          "change": -100
        },
        {
          "type": "origins:execute_command",
          "command": "elijah blood_rush"
        },
        {
          "type": "origins:execute_command",
          "command": "elijah blood_overdrive"
        }
      ]
    },
    "else_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:change_resource",
          "resource": "elijah:blood_resource",
          "change": 20
        },
        {
          "type": "origins:execute_command",
          "command": "elijah blood_rush"
        }
      ]
    }
  },
  "cooldown": 300,
  "hud_render": {
    "should_render": false
  },
  "key": {
    "key": "key.origins.quinary_active",
    "continuous": false
  }
}
